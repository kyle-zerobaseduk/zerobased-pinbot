# PinBot V2
# Never commit real tokens or API keys to GitHub.

# Pinterest access token for the K.D.Publishing Pinterest account
PINTEREST_TOKEN_KDP=your_kd_publishing_access_token_here

# Pinterest access token for the ZeroBased UK Pinterest account
PINTEREST_TOKEN_ZEROBASED=your_zerobased_uk_access_token_here

# Optional AI copy generation. If blank, PinBot uses saved descriptions/fallback copy.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# UK timezone
TZ=Europe/London

# Persistent data directory. On Railway attach a volume and point this at it.
DATA_DIR=./data

# Railway sets PORT automatically in production.
PORT=3000
NODE_ENV=production
