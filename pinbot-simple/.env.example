# ---------------------------------------------------------------
# PinBot Simple - environment variables
# Only DASHBOARD_PASSWORD is required to start.
# Everything else can be added later.
# ---------------------------------------------------------------

# The password you type to open your dashboard. REQUIRED.
DASHBOARD_PASSWORD=choose-a-password

# Where data is stored. On Railway with a volume mounted at /data use: /data
DATA_DIR=./data

# Your app's public address (needed only for Pinterest login).
# Example: https://pinbot.zerobaseduk.co.uk
APP_URL=

# Pinterest app credentials (added once Pinterest approves your app).
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Optional: enables AI-written titles/descriptions.
# Without it, PinBot uses its built-in offline copywriter instead.
ANTHROPIC_API_KEY=

# Optional overrides
TZ=Europe/London
PORT=3000
